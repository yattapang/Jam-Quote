# Dependencies
node_modules/
.pnp.*
.yarn/*

# Builds
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Expo
.expo/
web-build/
*.apk
*.aab
*.ipa

# Env & secrets
.env
.env.*
!.env.example

# Prisma
apps/api/prisma/*.db
apps/api/prisma/migrations/dev/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local (personal) settings
**/.claude/settings.local.json
# Everything under .claude is local EXCEPT the review agent briefs, which are
# project infrastructure: nine section reviewers plus commit-reviewer, carrying the
# defect taxonomy and review method this codebase was hardened with. They were
# ignored, so a fresh clone got none of them. Same idiom as .vscode above — a
# directory-level ignore cannot be undone from inside, hence `/*` plus a negation.
**/.claude/
!/.claude/
/.claude/*
!/.claude/agents/

# Design source (kept out of app build, retained locally)
extracted/.thumbnail
