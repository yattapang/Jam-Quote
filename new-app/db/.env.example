# Copy to .env and fill in. .env is git-ignored; never commit a real value (Rule 5).

# Pooled connection, used by the application at runtime.
DATABASE_URL="postgresql://pryvis:pryvis@localhost:5432/pryvis?schema=public"

# UNPOOLED host, used only for migrations. Required, and not optional in practice:
# through a connection pooler Prisma's session-level advisory lock is recycled onto
# another connection and never released, which stranded a lock on every boot in the
# previous application until the service stopped starting at all.
DIRECT_URL="postgresql://pryvis:pryvis@localhost:5432/pryvis?schema=public"
