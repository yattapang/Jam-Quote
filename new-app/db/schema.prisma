// Pryvis — the database schema, and the single source of truth for its structure
// (ADR 0012). Read by the api, by the migrations, by the seeds and by tooling,
// which is why it lives in db/ and belongs to none of them.
//
// WHAT THIS FILE CANNOT TELL YOU
//
// Prisma does not model row-level security, so the isolation rule that actually
// protects tenants is NOT visible here. It lives in db/policies/, is applied by
// the migrations, and is what makes a forgotten `where` clause a no-op instead of
// a breach. Read db/policies/001-tenant-isolation.sql before trusting anything in
// this file to keep tenants apart.
//
// CONVENTIONS (ADR 0012)
//
// - Tables and columns are snake_case; Prisma models are PascalCase and map onto
//   them explicitly, so the SQL a reviewer reads matches the SQL in the policies.
// - The tenant column is `tenant_id` on every tenant-owned table, with no
//   exceptions, because the policy in db/policies/ is written once against that
//   name and a table that spells it differently is a table with no protection.
// - Money is integer minor units in 64-bit columns, named `…_minor_units`
//   (ADR 0011). No money exists yet in this skeleton; when it arrives it arrives
//   as BigInt.
// - State that grows (plan, status) is text, not a database enum (ADR 0002).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migrations run over a direct (unpooled) connection. Prisma takes a
  // session-level advisory lock while migrating; through a connection pooler
  // that lock is recycled onto another connection and never released, which
  // stranded a lock on every boot in the previous application and eventually
  // stopped the service from starting at all. Learned the expensive way — see
  // original-app/render.yaml.
  directUrl = env("DIRECT_URL")
}

/// A tenant is one contracting business using Pryvis. It is the unit of
/// isolation: every other tenant-owned row points at exactly one of these, and
/// the row-level-security policies are written in terms of it.
///
/// The contractor never sees the word "tenant" — the UI says "business"
/// (ADR 0012). The word is for us, and it is used consistently in the code so
/// that "which business?" never has two meanings.
model Tenant {
  id String @id @default(uuid()) @db.Uuid

  /// The trading name, as the contractor types it. Displayed on their documents.
  name String

  /// ISO 3166-1 alpha-2. Selects the jurisdiction rule pack: tax rules, taxpayer
  /// id format, document wording, day boundary, and the money ceiling
  /// (ADR 0011). Never branched on in product code (Rule 3) — it is a key into
  /// data.
  countryCode String @map("country_code") @db.Char(2)

  /// ISO 4217. The currency this tenant quotes and invoices in, which is
  /// deliberately separate from the currency Pryvis bills them in.
  currency String @db.Char(3)

  /// Set when this tenant's access is suspended - non-payment, or an
  /// investigation. Their data stays intact; their users stop getting in on their
  /// next request, because core/auth re-reads this on every one.
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(6)

  /// Compared on every write: UPDATE ... SET version = version + 1 WHERE id = ? AND version = ?.
  /// Zero rows affected means somebody else got there first, and the caller is told rather than
  /// having their edit vanish. Also the conflict signal offline sync needs - one column, two
  /// jobs. NOT updated_at: clocks disagree and a backwards correction makes a stale write look
  /// fresh.
  version Int @default(1)

  /// NULL means live. Soft delete where history matters (Rule 6), and the only way a client
  /// that has been offline can learn a row is gone rather than not-yet-seen.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users        AppUser[]
  sessions     AppSession[]
  credentials  AppCredential[]
  auditEntries AuditEntry[]
  documentRenders DocumentRender[]

  // The Documents core (ADR 0025). Prisma requires the back-relation for every model that names a
  // tenant; the schema-migration-parity guard resolves relations against model names so an optional
  // back-relation is not mistaken for a missing table (finding F11's false positive).
  clients               Client[]
  numberSeries          NumberSeries[]
  quotes                Quote[]
  quoteSections         QuoteSection[]
  quoteLines            QuoteLine[]
  quoteIssues           QuoteIssue[]
  quoteIssueLines       QuoteIssueLine[]
  issueNumbers          IssueNumber[]
  acceptances           Acceptance[]
  acceptanceWithdrawals AcceptanceWithdrawal[]
  variations            Variation[]
  invoices              Invoice[]
  invoiceVoids          InvoiceVoid[]
  creditNotes           CreditNote[]
  issueBalances         IssueBalance[]
  rejectedSeals         RejectedSeal[]
  rejectedSealLines     RejectedSealLine[]

  @@map("tenant")
}

/// A person who signs in. Belongs to exactly one tenant.
///
/// Named AppUser, mapping to "app_user", because `user` is reserved in Postgres
/// and a table called "user" needs quoting everywhere forever — including inside
/// the policy SQL, where an unquoted slip would be a silent failure.
model AppUser {
  id String @id @default(uuid()) @db.Uuid

  /// The isolation key. Present on every tenant-owned table under exactly this
  /// name (ADR 0012), because db/policies/ is written against it.
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Unique per tenant, not globally: the same person may legitimately hold an
  /// account at two contracting businesses, and a global unique would make one
  /// tenant's sign-up fail because of a row it is not allowed to see — leaking
  /// the existence of another tenant's user through an error message.
  ///
  /// Stored already lower-cased and trimmed by core/auth, not by a database
  /// type: citext would need a preview feature and an extension, and one
  /// normalisation rule applied at the boundary is easier for a reader to find
  /// than a collation they have to know to look for. The unique index below is
  /// therefore only as good as that rule, which is why the rule has its own test.
  ///
  /// Held here for display and addressing. The email sign-in matches against lives
  /// on AppCredential, which is globally unique (ADR 0015).
  email String @db.VarChar(320)

  /// "owner" | "staff". Text, not an enum: roles grow, and a new role should not
  /// need a migration (ADR 0002). Authorisation is default-deny and re-resolved
  /// from this row on every request, never read from a token.
  role String

  /// Bumping this makes every token already issued for this user stale on its next
  /// request - password change, sign-out-everywhere, suspected compromise. One
  /// UPDATE, no blacklist to maintain, nothing to wait out. The previous
  /// application had no way to invalidate a live 30-day session at all.
  sessionVersion Int @default(0) @map("session_version")

  /// A user who may no longer sign in, without deleting the row their documents
  /// and audit entries point at.
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)

  /// See Tenant.version.
  version Int @default(1)

  /// Distinct from deactivatedAt, which means "may no longer sign in" while remaining a member
  /// of the business. This means removed. The two answer different questions, and a user can be
  /// deactivated without being deleted.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions             AppSession[]
  credential           AppCredential?
  platformCapabilities PlatformCapability[]
  mfaTotp              MfaTotp?
  mfaRecoveryCodes     MfaRecoveryCode[]
  documentRenders      DocumentRender[]
  capabilitiesGranted  PlatformCapability[] @relation("CapabilityGrantedBy")
  auditEntries         AuditEntry[]         @relation("AuditActor")

  /// The real index is PARTIAL - `WHERE deleted_at IS NULL` - so a deleted user's address is not
  /// held hostage forever and the business can re-invite the same person. Prisma cannot express a
  /// partial unique index, so the migration owns it and this declaration is the closest Prisma
  /// can come. db/test/row-convention.test.ts asserts the real index is the partial one, because
  /// a schema that cannot state the truth needs something that can.
  @@unique([tenantId, email])
  @@index([tenantId])
  /// J3: exists so a child's foreign key can reference the PAIR, making a cross-tenant
  /// child unrepresentable rather than merely invisible. Redundant as uniqueness; that is
  /// the point.
  @@unique([id, tenantId])
  @@map("app_user")
}

/// A signed-in session.
///
/// THE ONE TABLE WITHOUT ROW-LEVEL SECURITY, and the migration that creates it
/// explains why at length: it is what ESTABLISHES `app.tenant_id`, so a policy
/// requiring a tenant would make it unreadable at exactly the moment it is needed.
/// It is kept thin on purpose - ids, a version, timestamps, and nothing about
/// anybody's business - and every read that follows it, including the user's own
/// role, happens under row-level security with the tenant this row supplied.
///
/// The exemption is named and reasoned in db/test/policy-parity.test.ts, so a
/// second table cannot join it quietly.
model AppSession {
  id String @id @default(uuid()) @db.Uuid

  userId String  @map("user_id") @db.Uuid
  user   AppUser @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// Denormalised from app_user deliberately: reading it from there would require a
  /// tenant to already be set, which is the problem this table exists to solve.
  /// This is the ONE place a tenant id enters a request, and it comes from our own
  /// session store - never from a caller.
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// app_user.session_version at the moment this session was issued. A mismatch on
  /// any later request means the session was superseded.
  version Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Short, and rotated on use - not the thirty days the audit found.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// Revoked, never deleted: a session that was used to do something is history.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// The password was accepted; a second factor is still owed. Staff sessions start here
  /// (Rule 5.1). Added by the MFA migration and MISSING from this model until F11 was found -
  /// see schema-migration-parity.test.ts, which now refuses that kind of drift.
  mfaPending Boolean @default(false) @map("mfa_pending")

  /// When the factor was last proved on this session. mfaPending answers "ever"; Rule 5.1 asks for
  /// RE-authentication before impersonation or a price change, and "ever" cannot answer that - a
  /// laptop walked away from has a session that passed a factor hours ago.
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("app_session")
}

/// A password, and the email it is matched against.
///
/// THE SECOND AND LAST TABLE OUTSIDE ROW-LEVEL SECURITY. Sign-in must find a user by
/// email before any tenant is known, and AppUser is behind RLS, so the lookup that
/// STARTS authentication cannot read it. Same boundary as AppSession, same explicit
/// treatment: both exemptions are named with their reasons in
/// db/test/policy-parity.test.ts, and a third cannot appear quietly.
///
/// Splitting the hash out of AppUser buys something beyond making sign-in possible:
/// the row every module reads no longer carries a password at all, so a widened
/// SELECT in some future query cannot leak one.
///
/// The email here is GLOBALLY unique, unlike AppUser.email which is unique per
/// tenant. That trade-off - one person cannot use one address at two businesses - is
/// recorded in ADR 0015.
model AppCredential {
  id String @id @default(uuid()) @db.Uuid

  /// One password per user. A passkey or an OAuth identity will be its own table, not
  /// another row here, so this model stays "the password".
  userId String  @unique @map("user_id") @db.Uuid
  user   AppUser @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// Denormalised for the same reason AppSession does it: the tenant must be known
  /// before row-level security can be satisfied, and this is where it comes from.
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Normalised (lower-cased, trimmed) in ONE place - SignInService.normaliseEmail -
  /// so this unique index means what it appears to mean.
  email String @unique @db.VarChar(320)

  /// scrypt$N$r$p$salt$hash. The parameters travel with the hash so the cost can be
  /// raised on a successful sign-in, which is the only moment the plaintext exists
  /// (ADR 0014).
  passwordHash String @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// J3. Prisma requires this in the relation's field order; the real index is
  /// (tenant_id, <column>), tenant first, because every query filters on the tenant. Same
  /// uniqueness, different column order, and the migration owns the index.
  @@unique([userId, tenantId])
  @@map("app_credential")
}

// ---------------------------------------------------------------------------
// Rate limiting, staff capabilities and second factors.
//
// These four models were MISSING while their tables existed (F11, independent review
// 2026-09-24). Prisma compares this file against a live database to plan a migration, so four
// real tables - rate limits, staff capabilities, TOTP secrets and recovery codes - looked like
// surplus and would have been DROPPED by a tool doing exactly what it is designed to do.
//
// Nothing caught it because every test replays migration SQL directly and never asks Prisma
// anything. db/test/schema-migration-parity.test.ts now compares both sides, in both directions.
// ---------------------------------------------------------------------------

/// A token bucket. Not tenant-scoped, and consulted before anyone is identified - which is its
/// purpose (ADR 0016). Holds no personal data: an email dimension is keyed by a hash.
model RateLimitBucket {
  /// "<action>:<dimension>:<value>", e.g. "signin:ip:203.0.113.4".
  key String @id

  /// Fractional on purpose: tokens refill continuously, and rounding would either give attempts
  /// away or swallow them.
  tokens Float

  /// When `tokens` was last correct. Refill is computed from the gap, so no sweeper is needed and
  /// an idle bucket costs nothing.
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([updatedAt])
  @@map("rate_limit_bucket")
}

/// What one of OUR staff may do. Deliberately not tenant-scoped: a platform capability is not a
/// fact about any tenant (Rule 5.1). A grant has an author and a timestamp, or least privilege is
/// a slogan.
model PlatformCapability {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// e.g. "impersonate_tenant", "manage_pricing", "read_audit". Text, not an enum: capabilities
  /// grow, and a new one should not need a migration (ADR 0002).
  capability String

  /// NULL only for the bootstrap grant created before any person exists. Every other grant names
  /// who made it.
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  /// The foreign key was missing until finding J9's guard reported it: Rule 5.1 asks that a grant
  /// have an author, and the database would previously have accepted any UUID as that author.
  grantedBy       AppUser? @relation("CapabilityGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  grantedAt       DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  /// Revoked rather than deleted: who could do what, and when, is history.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("platform_capability")
}

/// A TOTP second factor.
///
/// The secret is ENCRYPTED AT REST (AES-256-GCM, key in configuration and never in the database).
/// A TOTP secret is a credential equal to the password, so storing it in plaintext beside a slow
/// password hash would hand an attacker with a dump both factors and the second one would have
/// bought nothing.
model MfaTotp {
  userId String  @id @map("user_id") @db.Uuid
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  secretCiphertext Bytes @map("secret_ciphertext")

  /// Which encryption key sealed this secret.
  ///
  /// Without it, rotating the key makes every enrolled secret undecryptable and forces every staff
  /// member to re-enrol - so in practice the key is never rotated and "encrypted at rest" becomes
  /// "encrypted with a key we can never change". Two keys may be live: new secrets use the current
  /// one, existing rows decrypt with the key they name.
  secretKeyId String @default("k1") @map("secret_key_id")
  /// Not secret, and GCM cannot detect tampering without the tag.
  secretIv  Bytes @map("secret_iv")
  secretTag Bytes @map("secret_tag")

  /// Set when the person has proved they can generate a code. An unconfirmed factor protects
  /// nobody: it means a secret was issued and may never have reached an authenticator.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)

  /// The last 30-second step this factor was used for. A TOTP code stays valid for its whole
  /// step, so without this a captured code can be replayed inside the same window.
  lastUsedStep BigInt? @map("last_used_step")

  /// Consecutive failures, and a lock that FOLLOWS THE PERSON rather than the session. The rate
  /// limiter is the first line and bounds attempts per session and per IP; this is the second, and
  /// it survives a new session - so an attacker cannot reset their guessing budget by signing in
  /// again with a password they have already stolen.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("mfa_totp")
}

/// A single-use recovery code.
///
/// Hashed with SHA-256 and no salt, which looks wrong beside the scrypt used for passwords and is
/// deliberate: a recovery code is ~100 bits of randomness WE generate, so there is no dictionary
/// to try, while generating ten at scrypt's cost would mean 670 MB of work to enrol one person.
model MfaRecoveryCode {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String @unique @map("code_hash")

  /// Marked rather than deleted, so "a recovery code was used" is a fact the audit trail can
  /// point at.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("mfa_recovery_code")
}

/// Who did what, to which tenant, when.
///
/// APPEND-ONLY, ENFORCED BY THE ABSENCE OF A POLICY. The table has policies for SELECT and INSERT
/// and none for UPDATE or DELETE, so Postgres refuses those commands even to a role that HOLDS
/// the grant. A trail the application can edit is a trail that will be edited. There is no
/// amend(): a mistaken entry is corrected by a later entry.
///
/// tenant_id is NOT NULL deliberately. A staff action against a tenant carries that tenant's id,
/// which is exactly the set Rule 5.1 says the tenant should be able to see - so the ordinary
/// tenant policy lets a tenant read what we did to them, with no special case. Staff actions with
/// no tenant need platform_audit_entry, which lands with the admin console.
///
/// Exempt from the row convention (version, deleted_at): see db/test/row-convention.test.ts.
model AuditEntry {
  /// A UUIDv7, so entries sort chronologically by primary key (ADR 0019) - which for a table read
  /// in time order during an incident is the whole index strategy.
  id String @id @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The moment of the ACTION, not of the write. An entry written by a retried job describes when
  /// the thing happened.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// "tenant_user" | "platform_staff" | "system". Text, not an enum: actor kinds grow (an API key,
  /// an integration) and a new one should not need a migration (ADR 0002).
  actorKind String @map("actor_kind")

  /// NULL only for "system" - enforced by a CHECK, because a human action with no actor is not an
  /// audit entry, it is a rumour.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Enforced from finding J9's guard onwards. An audit entry naming a user id that never existed
  /// is not a gap in the trail, it is a false trail.
  actorUser   AppUser? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  /// From the AuditAction union in @pryvis/core, so a typo cannot invent a new action and split
  /// one behaviour across two names nobody thinks to search for.
  action String

  subjectType String  @map("subject_type")
  subjectId   String? @map("subject_id") @db.Uuid

  /// One sentence a person can read during an incident without decoding the details.
  summary String

  /// Redacted by the writer. core/audit refuses a payload carrying a password, token, secret or
  /// hash: this is the one table humans read under pressure.
  details Json @default("{}")

  /// Personal data, kept deliberately - after a compromise "which address" is the question. The
  /// privacy notice says we keep it and why.
  actorIp String? @map("actor_ip") @db.Inet

  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, subjectType, subjectId])
  @@map("audit_entry")
}

// ===========================================================================
// THE DOCUMENTS CORE (migration 20260925120000_documents_core, ADR 0025)
//
// Every table below has a model here because `db/test/schema-migration-parity.test.ts`
// fails otherwise — a table with no model is a table `prisma migrate diff` would
// propose DROPPING, which is how finding F11 nearly lost four tables.
//
// The five invariants are NOT expressed here, and cannot be: Prisma has no way to say
// "written only through a function", "no UPDATE policy" or "this column is derived".
// They live in the migration, which is the point of ADR 0025 — the schema file
// describes the shape, the migration holds the rules.
// ===========================================================================

model Client {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name String

  /// Nullable, and PRD finding H9 is open because of it: the e-signature's verification code
  /// needs a channel and nothing requires a client to have one. Recorded rather than quietly
  /// required, because making it mandatory is a decision about clients already on file.
  email String?
  phone String?

  quotes Quote[]

  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  /// J3: exists so a child's foreign key can reference the PAIR, making a cross-tenant
  /// child unrepresentable rather than merely invisible. Redundant as uniqueness; that is
  /// the point.
  @@unique([id, tenantId])
  @@map("client")
}

model NumberSeries {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  documentKind String @map("document_kind")
  prefix       String @default("")

  /// Allocated under a row lock, which is the shape ADR 0025 decision 2 copies for the balance.
  nextNumber BigInt @default(1) @map("next_number")
  resetRule  String @default("never") @map("reset_rule")

  issueNumbers IssueNumber[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, documentKind])
  /// J3: exists so a child's foreign key can reference the PAIR, making a cross-tenant
  /// child unrepresentable rather than merely invisible. Redundant as uniqueness; that is
  /// the point.
  @@unique([id, tenantId])
  @@map("number_series")
}

model Quote {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clientId String @map("client_id") @db.Uuid
  client   Client @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)

  title String

  /// Frozen into the issue when sealed: changing it later would alter what a client was shown
  /// (finding F14).
  clientDetailLevel String @default("itemised") @map("client_detail_level")
  currency          String

  sections      QuoteSection[]
  lines         QuoteLine[]
  issues        QuoteIssue[]
  rejectedSeals RejectedSeal[]

  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  /// J3: exists so a child's foreign key can reference the PAIR, making a cross-tenant
  /// child unrepresentable rather than merely invisible. Redundant as uniqueness; that is
  /// the point.
  @@unique([id, tenantId])
  @@map("quote")
}

model QuoteSection {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  quoteId  String @map("quote_id") @db.Uuid
  quote    Quote  @relation(fields: [quoteId, tenantId], references: [id, tenantId], onDelete: Cascade)

  title    String
  position Int

  lines QuoteLine[]

  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([quoteId])
  /// J3: exists so a child's foreign key can reference the PAIR, making a cross-tenant
  /// child unrepresentable rather than merely invisible. Redundant as uniqueness; that is
  /// the point.
  @@unique([id, tenantId])
  @@map("quote_section")
}

model QuoteLine {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  quoteId   String       @map("quote_id") @db.Uuid
  quote     Quote        @relation(fields: [quoteId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sectionId String       @map("section_id") @db.Uuid
  section   QuoteSection @relation(fields: [sectionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  description String
  position    Int

  /// Money is BigInt minor units and quantity is thousandths, both integers. No float touches
  /// either (Rule 3, ADR 0011) — the old application capped at $21,474,836.47 on a 32-bit type.
  quantityThousandths BigInt @map("quantity_thousandths")
  unitPriceMinor      BigInt @map("unit_price_minor")
  lineTotalMinor      BigInt @map("line_total_minor")

  /// Which recipe produced it, so a recipe change can offer to refresh a draft — never an issue.
  recipeId String? @map("recipe_id") @db.Uuid

  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([quoteId])
  @@map("quote_line")
}

/// The sealed snapshot. Append-only in the database (no UPDATE or DELETE policy), which Prisma
/// cannot express — see the migration.
model QuoteIssue {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  quoteId  String @map("quote_id") @db.Uuid
  quote    Quote  @relation(fields: [quoteId, tenantId], references: [id, tenantId], onDelete: Restrict)
  revision Int

  clientId            String @map("client_id") @db.Uuid
  clientName          String @map("client_name")
  title               String
  clientDetailLevel   String @map("client_detail_level")
  currency            String
  termsText           String @map("terms_text")
  taxRateBasisPoints  Int    @map("tax_rate_basis_points")
  subtotalMinor       BigInt @map("subtotal_minor")
  taxMinor            BigInt @map("tax_minor")
  totalMinor          BigInt @map("total_minor")

  sealedAt       DateTime @map("sealed_at") @db.Timestamptz(6)
  sealedByUserId String   @map("sealed_by_user_id") @db.Uuid

  /// When the prices this froze were last refreshed. PRD R1.13a gives it a reader, which is what
  /// stops it being decoration (finding G6).
  catalogSyncedAt DateTime  @map("catalog_synced_at") @db.Timestamptz(6)
  expiresOn       DateTime? @map("expires_on") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  lines      QuoteIssueLine[]
  number     IssueNumber?
  acceptance Acceptance?
  variations Variation[]
  invoices   Invoice[]
  balance    IssueBalance?

  /// One sealed issue per revision of a quote. This index IS the answer to finding G4: two devices
  /// can both seal the same draft offline and neither push conflicts, because each is an INSERT.
  @@unique([tenantId, quoteId, revision])
  @@index([tenantId])
  renders DocumentRender[]

  /// J3: exists so a child's foreign key can reference the PAIR, making a cross-tenant
  /// child unrepresentable rather than merely invisible. Redundant as uniqueness; that is
  /// the point.
  @@unique([id, tenantId])
  @@map("quote_issue")
}

model QuoteIssueLine {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @map("tenant_id") @db.Uuid
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issueId  String     @map("issue_id") @db.Uuid
  issue    QuoteIssue @relation(fields: [issueId, tenantId], references: [id, tenantId], onDelete: Restrict)

  sectionTitle        String @map("section_title")
  description         String
  position            Int
  quantityThousandths BigInt @map("quantity_thousandths")
  unitPriceMinor      BigInt @map("unit_price_minor")
  lineTotalMinor      BigInt @map("line_total_minor")
  taxTreatment        String @map("tax_treatment")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([issueId])
  @@map("quote_issue_line")
}

/// The number, in its own insert-only row rather than a nullable column on the issue — filling one
/// in later would be an UPDATE on a sealed financial document (ADR 0025 decision 1).
model IssueNumber {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @map("tenant_id") @db.Uuid
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issueId  String       @map("issue_id") @db.Uuid
  issue    QuoteIssue   @relation(fields: [issueId, tenantId], references: [id, tenantId], onDelete: Restrict)
  seriesId String       @map("series_id") @db.Uuid
  series   NumberSeries @relation(fields: [seriesId, tenantId], references: [id, tenantId], onDelete: Restrict)

  number      BigInt
  formatted   String
  allocatedAt DateTime @default(now()) @map("allocated_at") @db.Timestamptz(6)

  @@unique([tenantId, seriesId, number])
  /// J3. Prisma requires this in the relation's field order; the real index is
  /// (tenant_id, <column>), tenant first, because every query filters on the tenant. Same
  /// uniqueness, different column order, and the migration owns the index.
  @@unique([issueId, tenantId])
  @@map("issue_number")
}

model Acceptance {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @map("tenant_id") @db.Uuid
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issueId  String     @map("issue_id") @db.Uuid
  issue    QuoteIssue @relation(fields: [issueId, tenantId], references: [id, tenantId], onDelete: Restrict)

  outcome    String
  signerName String @map("signer_name")

  /// The verified channel and the consent are what make this an e-signature rather than a typed
  /// name, which the owner ruled is not legal in a dispute (ADR 0024).
  verifiedChannel     String?  @map("verified_channel")
  verifiedDestination String?  @map("verified_destination")
  consentedToSign     Boolean  @default(false) @map("consented_to_sign")

  /// What was signed: the render, whose hash is the document. Not a hash of its own (finding F17).
  /// The foreign key arrived with the table, in finding J9's migration.
  documentRenderId String?         @map("document_render_id") @db.Uuid
  documentRender   DocumentRender? @relation(fields: [documentRenderId, tenantId], references: [id, tenantId], onDelete: Restrict)

  actorIp    String?  @map("actor_ip")
  userAgent  String?  @map("user_agent")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  withdrawal AcceptanceWithdrawal?

  /// J3: exists so a child's foreign key can reference the PAIR, making a cross-tenant
  /// child unrepresentable rather than merely invisible. Redundant as uniqueness; that is
  /// the point.
  @@unique([id, tenantId])
  /// J3. Prisma requires this in the relation's field order; the real index is
  /// (tenant_id, <column>), tenant first, because every query filters on the tenant. Same
  /// uniqueness, different column order, and the migration owns the index.
  @@unique([issueId, tenantId])
  @@map("acceptance")
}

/// The produced PDF, whose hash IS the document (PRD R1.16a, finding F17). Built by finding J9's
/// migration: `acceptance.documentRenderId` pointed at this table for a day before it existed.
///
/// Append-only. The render points at its issue rather than the reverse, because an issue is sealed
/// before it is rendered and a sealed row has no UPDATE path by which to gain a pointer.
model DocumentRender {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  issueId String     @map("issue_id") @db.Uuid
  issue   QuoteIssue @relation(fields: [issueId, tenantId], references: [id, tenantId], onDelete: Restrict)

  /// Provider-agnostic on purpose: object storage is an owner decision still outstanding.
  storageKey String @map("storage_key")
  /// Lowercase hex, 64 characters, checked by the migration — a hash column that accepts anything
  /// will one day hold "pending".
  sha256   String
  byteSize BigInt @map("byte_size")
  /// Logo, terms version, tax configuration: what the render was produced WITH, so a later
  /// re-render can be compared like with like.
  settings Json

  renderedAt       DateTime @default(now()) @map("rendered_at") @db.Timestamptz(6)
  renderedByUserId String?  @map("rendered_by_user_id") @db.Uuid
  renderedBy       AppUser? @relation(fields: [renderedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  acceptances Acceptance[]

  @@unique([tenantId, issueId, sha256])
  @@index([issueId])
  /// J3: exists so a child's foreign key can reference the PAIR, making a cross-tenant
  /// child unrepresentable rather than merely invisible. Redundant as uniqueness; that is
  /// the point.
  @@unique([id, tenantId])
  @@map("document_render")
}

/// Withdrawal as its own insert-only row (ADR 0025 decision 4). A nullable `withdrawnAt` on
/// Acceptance would need an UPDATE grant on a document a client signed.
model AcceptanceWithdrawal {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  acceptanceId String     @map("acceptance_id") @db.Uuid
  acceptance   Acceptance @relation(fields: [acceptanceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  reason             String
  withdrawnByUserId  String   @map("withdrawn_by_user_id") @db.Uuid
  occurredAt         DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// J3. Prisma requires this in the relation's field order; the real index is
  /// (tenant_id, <column>), tenant first, because every query filters on the tenant. Same
  /// uniqueness, different column order, and the migration owns the index.
  @@unique([acceptanceId, tenantId])
  @@map("acceptance_withdrawal")
}

model Variation {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @map("tenant_id") @db.Uuid
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issueId  String     @map("issue_id") @db.Uuid
  issue    QuoteIssue @relation(fields: [issueId, tenantId], references: [id, tenantId], onDelete: Restrict)

  description String

  /// May be negative: a variation can remove scope as well as add it.
  amountMinor BigInt @map("amount_minor")

  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The idempotency key for the offline path (migration 20260926100000). A variation can be
  /// recorded with no signal and replayed from an outbox; without a key the retry inserts a second
  /// append-only row, raising the invoiceable ceiling permanently, and the reconciliation job then
  /// certifies the inflated figure as correct. Supplied by the device, because only the client can
  /// tell a retry from a genuine second variation of the same amount on the same day.
  clientReference String? @map("client_reference")

  @@unique([tenantId, issueId, clientReference])
  @@index([issueId])
  @@map("variation")
}

model Invoice {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @map("tenant_id") @db.Uuid
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issueId  String     @map("issue_id") @db.Uuid
  issue    QuoteIssue @relation(fields: [issueId, tenantId], references: [id, tenantId], onDelete: Restrict)

  kind        String
  amountMinor BigInt @map("amount_minor")
  currency    String

  issuedAt  DateTime  @map("issued_at") @db.Timestamptz(6)
  dueOn     DateTime? @map("due_on") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  void        InvoiceVoid?
  creditNotes CreditNote[]

  @@index([issueId])
  /// J3: exists so a child's foreign key can reference the PAIR, making a cross-tenant
  /// child unrepresentable rather than merely invisible. Redundant as uniqueness; that is
  /// the point.
  @@unique([id, tenantId])
  @@map("invoice")
}

model InvoiceVoid {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  reason          String
  voidedByUserId  String   @map("voided_by_user_id") @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// J3. Prisma requires this in the relation's field order; the real index is
  /// (tenant_id, <column>), tenant first, because every query filters on the tenant. Same
  /// uniqueness, different column order, and the migration owns the index.
  @@unique([invoiceId, tenantId])
  @@map("invoice_void")
}

model CreditNote {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceId String  @map("invoice_id") @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  amountMinor BigInt   @map("amount_minor")
  reason      String
  issuedAt    DateTime @map("issued_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([invoiceId])
  @@map("credit_note")
}

/// The derived cache that carries the lock (ADR 0025 decision 2).
///
/// The application cannot write this table at all: its write policies require a transaction-local
/// flag that only `issue_balance_apply()` sets. Prisma cannot express that, which is exactly why
/// the rule lives in the migration.
model IssueBalance {
  issueId  String     @id @map("issue_id") @db.Uuid
  issue    QuoteIssue @relation(fields: [issueId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenantId String     @map("tenant_id") @db.Uuid
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Written once from the accepted issue's own frozen lines, never again. Safe as a copy ONLY
  /// because the issue is immutable (finding G12).
  acceptedTotalMinor BigInt @map("accepted_total_minor")

  /// Re-summed from the rows inside the lock on every change, so these are a cache and never a
  /// second source of truth.
  variationsTotalMinor BigInt @default(0) @map("variations_total_minor")
  invoicedTotalMinor   BigInt @default(0) @map("invoiced_total_minor")

  recomputedAt DateTime @default(now()) @map("recomputed_at") @db.Timestamptz(6)

  /// J3. Prisma requires this in the relation's field order; the real index is
  /// (tenant_id, <column>), tenant first, because every query filters on the tenant. Same
  /// uniqueness, different column order, and the migration owns the index.
  @@unique([issueId, tenantId])
  @@map("issue_balance")
}

/// A pending registration is not a user and never becomes one by waiting (ADR 0025 decision 5).
///
/// No tenant, because it exists before any tenant does — named in policy-parity's EXEMPT list with
/// that reason. No unique constraint on the address either: many people may attempt the same one,
/// and the user row is inserted at verification, where `AppUser.email`'s global unique index makes
/// "first to verify wins" a database guarantee rather than application logic.
model RegistrationClaim {
  id    String @id @default(uuid()) @db.Uuid
  email String

  /// Hashed, because holding a claim token completes a registration — it is a credential.
  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  @@index([email])
  @@map("registration_claim")
}

/// A seal the server refused, kept as its own thing rather than forced into the issue sequence
/// (finding H7, migration 20260926120000).
///
/// "Offered as a revision" was impossible three ways: renumbering is an UPDATE on a sealed document,
/// a fresh issue from the same snapshot makes `sealedAt` lie, and letting the device renumber is the
/// offline revision the same requirement forbids. It was never an issue — it is a rejected attempt,
/// and what the product actually needed was the price the contractor gave at the gate, preserved.
model RejectedSeal {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  quoteId  String @map("quote_id") @db.Uuid
  quote    Quote  @relation(fields: [quoteId, tenantId], references: [id, tenantId], onDelete: Restrict)

  /// What the device believed it was sealing. Deliberately NOT unique with the quote: several devices
  /// may lose the same race and every attempt is worth keeping.
  revisionAttempted Int    @map("revision_attempted")
  refusalReason     String @map("refusal_reason")

  clientId      String @map("client_id") @db.Uuid
  clientName    String @map("client_name")
  title         String
  currency      String
  subtotalMinor BigInt @map("subtotal_minor")
  taxMinor      BigInt @map("tax_minor")
  totalMinor    BigInt @map("total_minor")

  /// The true moment of the seal on the device, never rewritten to sync time. With `pushedAt` it makes
  /// "who priced it first" answerable, even though first-to-sync is what decides.
  sealedAt        DateTime @map("sealed_at") @db.Timestamptz(6)
  sealedByUserId  String   @map("sealed_by_user_id") @db.Uuid
  catalogSyncedAt DateTime @map("catalog_synced_at") @db.Timestamptz(6)
  pushedAt        DateTime @default(now()) @map("pushed_at") @db.Timestamptz(6)

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolution String?

  /// The one field written after insert, so the one that needs a concurrency control: two people
  /// looking at the same list can resolve the same rejected seal, and this makes the second write fail
  /// rather than silently win.
  version Int @default(1)

  lines RejectedSealLine[]

  @@index([quoteId])
  /// J3: exists so a child's foreign key can reference the PAIR, making a cross-tenant
  /// child unrepresentable rather than merely invisible. Redundant as uniqueness; that is
  /// the point.
  @@unique([id, tenantId])
  @@map("rejected_seal")
}

model RejectedSealLine {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rejectedSealId String       @map("rejected_seal_id") @db.Uuid
  rejectedSeal   RejectedSeal @relation(fields: [rejectedSealId, tenantId], references: [id, tenantId], onDelete: Restrict)

  sectionTitle        String @map("section_title")
  description         String
  position            Int
  quantityThousandths BigInt @map("quantity_thousandths")
  unitPriceMinor      BigInt @map("unit_price_minor")
  lineTotalMinor      BigInt @map("line_total_minor")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([rejectedSealId])
  @@map("rejected_seal_line")
}

